{
  "name": "label-printer-miniapp",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "NIIM label design and NIIMBOT BLE printing workflow rebuilt as a native WeChat Mini Program",
  "scripts": {
    "build:vendor": "esbuild qrcode-generator --bundle --platform=browser --format=cjs --minify --legal-comments=inline --outfile=miniprogram/vendor/qrcode.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "check": "node scripts/check-project.mjs",
    "plan:authorized-redesign": "node scripts/plan-authorized-redesign.mjs",
    "redesign:batch": "node scripts/batch-redesign.mjs",
    "redesign:install": "node scripts/install-approved-redesigns.mjs",
    "release:shangyue": "node scripts/build-shangyue-release.mjs",
    "verify": "npm run check && npm test && npm run release:shangyue",
    "assets:sync": "python scripts/optimize_assets.py"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "qrcode-generator": "1.5.2"
  }
}
