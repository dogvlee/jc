/* Printer picker. Mirrors the editor's original device sheet; the sheet
   chrome (backdrop, handle, heading, buttons, glyph badge) comes from
   app.wxss through addGlobalClass. Component styles use class selectors only. */
.device-sheet {
  height: 74vh;
  display: flex;
  flex-direction: column;
}

.picker-heading-copy {
  min-width: 0;
}

.device-list {
  height: 0;
  flex: 1;
}

/* Rows are buttons; restate the app.wxss button reset here so they never
   pick up the native grey button look inside the component. */
.device-item {
  margin: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
}

.device-item::after {
  border: 0;
}

.device-item {
  width: 100%;
  min-height: 128rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  border: 4rpx solid transparent;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
  background: var(--color-fill);
  box-sizing: border-box;
}

/* The row being linked turns blue; the others fade until it finishes. */
.device-item.connecting {
  border-color: var(--color-info);
  background: var(--color-info-soft);
}

.device-item.connecting .device-status {
  color: var(--color-info-text);
}

.device-icon {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill-strong);
  font-size: 40rpx;
}

.device-icon.printer {
  color: var(--color-success);
  background: var(--color-success-soft);
}

.device-copy {
  min-width: 0;
  flex: 1;
}

.device-name {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-small);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-small);
}

.device-status {
  flex: none;
  color: var(--color-info-text);
  font-size: var(--font-small);
  font-weight: 500;
}

.device-chevron {
  color: var(--color-text-4);
  font-size: 28rpx;
}

.connected-card {
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--color-success-text);
  background: var(--color-success-soft);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.connected-card.pending {
  color: var(--color-text-3);
  background: var(--color-fill);
}

.connected-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  font-size: 36rpx;
}

.connected-copy {
  min-width: 0;
  flex: 1;
}

.connected-name {
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connected-actions {
  flex: none;
  display: flex;
  gap: 12rpx;
}

.picker-empty {
  min-height: 320rpx;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.5;
  text-align: center;
}

.picker-notice {
  flex: 1;
}

.picker-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.outline-button.picker-rescan {
  flex: 1;
  min-height: 88rpx;
  font-size: var(--font-subtitle);
}

.text-button.picker-check {
  flex: none;
}
