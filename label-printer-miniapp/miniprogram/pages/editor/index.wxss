page {
  height: 100%;
  overflow: hidden;
  background: #eef0f3;
  color: #25272b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: 26rpx;
  line-height: 1.2;
}

button::after { border: 0; }
button[disabled] { opacity: .35; }

.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.editor-header {
  flex: none;
  z-index: 4;
  background: #fff;
  border-bottom: 1rpx solid #e7e8eb;
}

.header-main {
  height: 78rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
}

.header-spacer { flex: 1; }
.history-actions { display: flex; margin-left: 14rpx; }

.icon-button {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  border-radius: 22rpx;
}

.icon-button:active { background: #f1f2f4; }
.icon-button.close { font-size: 48rpx; font-weight: 300; }

.document-row {
  height: 52rpx;
  padding: 0 28rpx 10rpx;
  display: flex;
  align-items: center;
}

.document-title {
  min-width: 0;
  flex: 1;
  height: 44rpx;
  font-size: 25rpx;
  color: #666b74;
}

.size-label { margin-left: 18rpx; color: #858a94; font-size: 24rpx; }
.connection-dot { width: 14rpx; height: 14rpx; margin-left: 14rpx; border-radius: 50%; background: #bec2c9; }
.connection-dot.connected { background: #24a66a; box-shadow: 0 0 0 6rpx rgba(36,166,106,.12); }
.connection-dot.connecting { background: #f4a23a; }

.canvas-stage {
  position: relative;
  flex: 1;
  min-height: 250rpx;
  padding: 56rpx 28rpx 70rpx;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.paper-shell {
  position: relative;
  flex: none;
  width: 672rpx;
  min-height: 96rpx;
  max-height: 720rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(42,48,58,.13);
}

.label-canvas,
.selection-canvas {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.selection-canvas { z-index: 2; }
.canvas-loading { position: absolute; color: #8a8f98; font-size: 24rpx; }

.selection-tip {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  max-width: 620rpx;
  transform: translateX(-50%);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 4rpx 18rpx rgba(42,48,58,.1);
  color: #7a7f88;
  font-size: 21rpx;
  white-space: nowrap;
}

.editor-panel {
  position: relative;
  flex: none;
  height: 610rpx;
  max-height: 48vh;
  min-height: 430rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(42,48,58,.07);
  overflow: hidden;
}

.panel-tabs {
  height: 84rpx;
  display: flex;
  border-bottom: 1rpx solid #eceef1;
}

.panel-tabs button {
  position: relative;
  flex: 1;
  color: #777d88;
  font-size: 25rpx;
}

.panel-tabs button.active { color: #f44336; font-weight: 600; }
.panel-tabs button.active::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: #f44336;
}

.panel-scroll {
  height: calc(100% - 178rpx);
  box-sizing: border-box;
}

.tool-grid {
  padding: 26rpx 22rpx 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.tool-button {
  width: 20%;
  height: 126rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #555c67;
  font-size: 22rpx;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  background: #f0f2f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #24272c;
  font-size: 35rpx;
}

.tool-button:active .tool-icon { background: #ffe9e7; color: #f44336; }

.panel-hint {
  padding: 12rpx 30rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999ea7;
  font-size: 22rpx;
  line-height: 1.8;
}

.inspector { padding: 8rpx 28rpx 42rpx; }
.inspector-heading { padding: 22rpx 0; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #eceef1; }
.eyebrow { display: block; color: #999ea6; font-size: 20rpx; text-transform: uppercase; }
.inspector-title { display: block; margin-top: 4rpx; font-size: 31rpx; font-weight: 700; }
.compact-actions { display: flex; }
.compact-actions button { padding: 12rpx 16rpx; color: #656b75; font-size: 22rpx; }
.compact-actions .danger-text { color: #e6483c; }

.property-section { padding: 22rpx 0; border-top: 1rpx solid #eceef1; }
.section-label { display: block; margin: 10rpx 0 14rpx; color: #6d737d; font-size: 23rpx; font-weight: 600; }
.text-area { width: 100%; min-height: 90rpx; padding: 18rpx 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #f5f6f8; font-size: 27rpx; line-height: 1.45; }
.text-area.small { min-height: 64rpx; }
.helper-text { display: block; margin-top: 14rpx; color: #9297a0; font-size: 22rpx; line-height: 1.6; }

.segment-row { margin: 16rpx -5rpx 2rpx; display: flex; flex-wrap: wrap; }
.segment-row button { min-width: 108rpx; flex: 1; margin: 5rpx; padding: 17rpx 10rpx; border: 1rpx solid #e0e3e8; border-radius: 13rpx; background: #fafbfc; color: #666d77; font-size: 22rpx; }
.segment-row button.active { border-color: #f44336; background: #fff0ef; color: #e23c31; font-weight: 600; }
.segment-row.three button { min-width: 30%; }

.switch-row,
.stepper-row,
.copies-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f1f3;
  font-size: 25rpx;
}

.stepper-row button { width: 60rpx; height: 52rpx; margin-left: 10rpx; border-radius: 14rpx; background: #f1f3f5; font-size: 32rpx; }
.stepper-row text { flex: 1; }
.preview-value { padding: 18rpx 20rpx; border-radius: 14rpx; background: #f5f6f8; display: flex; justify-content: space-between; color: #737984; font-size: 24rpx; }
.preview-value text:last-child { color: #23262b; font-weight: 600; }

.field-grid { display: flex; flex-wrap: wrap; margin: 8rpx -6rpx; }
.field-grid label { width: calc(50% - 12rpx); margin: 6rpx; padding: 14rpx 16rpx; box-sizing: border-box; border-radius: 14rpx; background: #f5f6f8; }
.field-grid.four label { width: calc(25% - 12rpx); }
.field-grid label text { display: block; color: #898e97; font-size: 20rpx; }
.field-grid input { height: 48rpx; color: #272a2f; font-size: 27rpx; font-weight: 600; }

.style-actions { display: flex; flex-wrap: wrap; margin: 8rpx -5rpx 16rpx; }
.style-actions button { min-width: 72rpx; height: 62rpx; margin: 5rpx; padding: 0 18rpx; border: 1rpx solid #e1e4e8; border-radius: 14rpx; font-weight: 700; }
.style-actions button.active { border-color: #f44336; background: #fff0ef; color: #e43f34; }
.style-actions .italic { font-style: italic; }
.style-actions .underline { text-decoration: underline; }
.style-actions .strike { text-decoration: line-through; }
.style-actions.wide button { flex: 1; font-weight: 500; font-size: 22rpx; }

.mode-scroll { width: 100%; white-space: nowrap; }
.mode-row { display: inline-flex; padding: 8rpx 0; }
.mode-row button { margin-right: 10rpx; padding: 16rpx 22rpx; border-radius: 14rpx; background: #f3f4f6; color: #686e78; }
.mode-row button.active { background: #fff0ef; color: #e43e33; }

.outline-wide,
.picker-field {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe2e7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  font-size: 25rpx;
}

.outline-wide { justify-content: center; color: #e54438; }
.table-cell-grid { display: flex; flex-wrap: wrap; margin: 12rpx -5rpx; }
.table-cell-grid input { width: calc(50% - 10rpx); height: 66rpx; margin: 5rpx; padding: 0 14rpx; box-sizing: border-box; border-radius: 12rpx; background: #f5f6f8; font-size: 23rpx; }

.simple-panel { height: calc(100% - 178rpx); padding: 34rpx 30rpx; box-sizing: border-box; }
.simple-title { display: block; margin-bottom: 24rpx; font-size: 31rpx; font-weight: 700; }
.simple-panel .outline-wide { margin-top: 18rpx; }

.editor-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  height: 94rpx;
  display: flex;
  border-top: 1rpx solid #e9ebee;
  background: #fff;
}

.editor-actions button { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 25rpx; }
.editor-actions button text { margin-right: 12rpx; font-size: 31rpx; }
.editor-actions .print-button { color: #f44336; }

.modal-backdrop { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; background: rgba(18,22,28,.42); }
.bottom-sheet {
  position: fixed;
  z-index: 21;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,.12);
  box-sizing: border-box;
}

.sheet-handle { width: 74rpx; height: 7rpx; margin: 14rpx auto 5rpx; border-radius: 7rpx; background: #d8dbe0; }
.sheet-heading { min-height: 100rpx; display: flex; align-items: center; justify-content: space-between; }
.sheet-title { display: block; font-size: 32rpx; font-weight: 700; }
.sheet-subtitle { display: block; margin-top: 8rpx; color: #8a909a; font-size: 22rpx; }
.sheet-close { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f2f3f5; font-size: 36rpx; }
.sheet-actions { padding-top: 20rpx; display: flex; }
.sheet-actions button { flex: 1; min-height: 76rpx; margin: 0 7rpx; border-radius: 16rpx; }
.outline-button, .danger-outline { border: 1rpx solid #dfe2e6; color: #555b65; }
.danger-outline { border-color: #ffc6c1; color: #e34539; background: #fff6f5; }
.danger-outline.full { width: 100%; min-height: 78rpx; margin-top: 18rpx; border-radius: 16rpx; }
.primary-button { background: #f44336; color: #fff; font-weight: 700; }

.device-sheet { height: 74vh; }
.device-list { height: calc(74vh - 270rpx); }
.device-item { width: 100%; min-height: 102rpx; padding: 16rpx 12rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #eceef1; text-align: left; }
.device-name { display: block; max-width: 520rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 600; }
.device-id { display: block; max-width: 500rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; color: #969ba4; font-size: 19rpx; }
.signal { color: #888e98; font-size: 22rpx; }
.connected-card { padding: 20rpx; border-radius: 18rpx; background: #eef9f3; display: flex; align-items: center; justify-content: space-between; color: #307354; font-size: 21rpx; }
.connected-card view { min-width: 0; }
.connected-name { display: block; margin-bottom: 6rpx; font-size: 27rpx; font-weight: 700; }
.connected-card button { padding: 14rpx 20rpx; border-radius: 13rpx; background: #fff; color: #2d7953; }
.sheet-empty { height: 280rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #949aa3; font-size: 23rpx; }
.empty-icon { margin-bottom: 16rpx; font-size: 64rpx; color: #c6cad0; }

.print-sheet { max-height: 88vh; }
.warning-card, .error-card { margin: 10rpx 0 16rpx; padding: 20rpx; border-radius: 16rpx; display: flex; flex-direction: column; background: #fff5df; color: #8c5a05; font-size: 23rpx; line-height: 1.5; }
.error-card { background: #fff0ef; color: #9c3027; }
.warning-title { margin-bottom: 6rpx; font-size: 26rpx; font-weight: 700; }
.warning-card button { align-self: flex-start; margin-top: 12rpx; padding: 12rpx 18rpx; border-radius: 12rpx; background: #fff; color: #d97812; font-size: 22rpx; }
.print-summary { padding: 4rpx 0; }
.print-summary view { min-height: 58rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #eff0f2; font-size: 24rpx; }
.print-summary view text:first-child { color: #818791; }
.copies-row { margin-top: 6rpx; }
.stepper { display: flex; align-items: center; }
.stepper button { width: 58rpx; height: 52rpx; border-radius: 14rpx; background: #f1f3f5; font-size: 31rpx; }
.stepper text { min-width: 70rpx; text-align: center; font-weight: 700; }
.progress-card { margin-top: 18rpx; color: #777d87; font-size: 22rpx; text-align: center; }
.progress-track { height: 10rpx; margin-bottom: 12rpx; overflow: hidden; border-radius: 10rpx; background: #eceef1; }
.progress-fill { height: 100%; border-radius: 10rpx; background: #f44336; transition: width .2s; }
.print-actions { padding-top: 24rpx; }

.settings-sheet { height: 84vh; }
.settings-scroll { height: calc(84vh - 140rpx); padding-bottom: 30rpx; box-sizing: border-box; }
.settings-scroll .picker-field { margin-bottom: 18rpx; }
.layers-sheet { height: 68vh; }
.layer-list { height: calc(68vh - 214rpx); }
.layer-item { width: 100%; min-height: 84rpx; padding: 12rpx 10rpx; display: flex; align-items: center; border-bottom: 1rpx solid #eceef1; text-align: left; }
.layer-item.active { background: #fff2f0; color: #e44237; }
.layer-type { width: 100rpx; color: #8b919a; font-size: 20rpx; text-transform: uppercase; }
.layer-name { flex: 1; max-width: 450rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; }
.layer-actions { height: 80rpx; display: flex; align-items: center; border-top: 1rpx solid #eceef1; }
.layer-actions button { flex: 1; height: 62rpx; border-radius: 14rpx; background: #f3f4f6; margin: 0 6rpx; color: #60666f; }
.layer-actions .danger-text { background: #fff0ef; color: #e44338; }

.material-sheet, .border-sheet { height: 74vh; }
.asset-grid, .border-grid { height: calc(74vh - 130rpx); display: flex; flex-wrap: wrap; }
.asset-grid button, .border-grid button { width: 25%; height: 160rpx; padding: 12rpx; box-sizing: border-box; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; color: #666c75; font-size: 21rpx; }
.asset-grid image, .asset-symbol, .border-sample { width: 92rpx; height: 92rpx; margin-bottom: 8rpx; border-radius: 16rpx; background: #f2f3f5; }
.asset-symbol { display: flex; align-items: center; justify-content: center; font-size: 46rpx; }
.border-sample { border: 3rpx solid #333; box-sizing: border-box; background: #fff; }
.border-grid button.active { color: #e44136; }
.border-grid button.active .border-sample { border-color: #f44336; box-shadow: 0 0 0 5rpx #ffe4e1; }
.border-sample.double { border-style: double; border-width: 8rpx; }
.border-sample.rounded { border-radius: 28rpx; }
.border-sample.dashed { border-style: dashed; }
.border-sample.thick { border-width: 8rpx; }

@media (max-height: 700px) {
  .editor-panel { height: 520rpx; min-height: 400rpx; }
  .canvas-stage { padding-top: 30rpx; padding-bottom: 44rpx; }
  .tool-button { height: 112rpx; }
  .tool-icon { width: 64rpx; height: 64rpx; }
}
