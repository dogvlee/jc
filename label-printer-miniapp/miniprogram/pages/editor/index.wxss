/* Editor: toolbar, canvas stage, bottom panel and sheets.
   Tokens, buttons, chips and sheet chrome live in app.wxss. */

page {
  height: 100%;
  overflow: hidden;
  background: #EEF0F3;
}

.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Toolbar */
.editor-header {
  flex: none;
  z-index: 4;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.header-main {
  height: 88rpx;
  padding-left: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.header-spacer {
  flex: 1;
}

.history-actions {
  margin-left: 8rpx;
  display: flex;
  gap: 4rpx;
}

button.icon-button {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  font-size: 40rpx;
}

button.icon-button.button-hover {
  background: var(--color-fill);
}

.icon-button.close {
  font-size: 44rpx;
}

.document-row {
  height: 64rpx;
  padding: 0 24rpx 12rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.document-name {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-4);
  font-size: 26rpx;
}

.document-title {
  min-width: 0;
  flex: 1;
  height: 48rpx;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
}

.size-label {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 22rpx;
}

.connection-status {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
}

.connection-status.connected {
  color: var(--color-success);
}

.connection-status.connecting {
  color: var(--color-warning);
}

.connection-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-4);
}

.connection-dot.connected {
  background: var(--color-success);
  box-shadow: 0 0 0 6rpx rgba(30, 158, 98, 0.14);
}

.connection-dot.connecting {
  background: var(--color-warning);
}

.template-attention {
  flex: none;
  padding: 16rpx 28rpx;
  display: flex;
  gap: 12rpx;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.template-attention .icon {
  margin-top: 4rpx;
  font-size: 28rpx;
}

/* Canvas stage: a light dot grid gives the label a design-tool backdrop. */
.canvas-stage {
  position: relative;
  flex: 1;
  min-height: 250rpx;
  padding: 72rpx 28rpx 80rpx;
  overflow: auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  box-sizing: border-box;
  background-color: #EEF0F3;
  background-image: radial-gradient(rgba(31, 35, 41, 0.1) 1.5rpx, transparent 1.8rpx);
  background-size: 28rpx 28rpx;
}

.paper-shell {
  position: relative;
  flex: none;
  width: 672rpx;
  margin-top: auto;
  margin-bottom: auto;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(31, 35, 41, 0.12), 0 0 0 1rpx rgba(31, 35, 41, 0.04);
}

.label-canvas,
.selection-canvas {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.selection-canvas {
  z-index: 2;
}

/* DevTools paints 2D canvases above sheets and ignores opacity/visibility.
   Slide them off-screen while a sheet is open; display:none would make
   initCanvas measure 0 x 0 when it runs under a sheet. */
.paper-shell.under-sheet .label-canvas,
.paper-shell.under-sheet .selection-canvas {
  transform: translateX(-200vw);
}

.canvas-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.selection-tip {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  max-width: 620rpx;
  transform: translateX(-50%);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  color: var(--color-text-2);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.08);
  font-size: 22rpx;
  white-space: nowrap;
}

button.draft-save-status {
  position: absolute;
  z-index: 3;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-success);
  background: var(--color-surface);
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.08);
  font-size: 22rpx;
  white-space: nowrap;
}

button.draft-save-status.error {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

/* Bottom panel. Tabs (88rpx) and the action bar (120rpx) are fixed; the
   middle area scrolls. */
.editor-panel {
  position: relative;
  flex: none;
  height: 640rpx;
  max-height: 48vh;
  min-height: 440rpx;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background: var(--color-surface);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.panel-tabs {
  height: 88rpx;
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
}

.panel-tabs button {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: var(--font-body);
}

.panel-tabs button.button-hover {
  background: transparent;
}

.panel-tabs button.active {
  color: var(--color-text-1);
  font-weight: 600;
}

/* ::before because buttons draw their border with ::after. */
.panel-tabs button.active::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
}

.panel-scroll {
  height: calc(100% - 208rpx);
  box-sizing: border-box;
}

.tool-grid {
  padding: 24rpx 16rpx 8rpx;
  display: flex;
  flex-wrap: wrap;
}

button.tool-button {
  width: 20%;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--color-text-2);
  font-size: 22rpx;
}

button.tool-button.button-hover {
  background: transparent;
}

.tool-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: 44rpx;
}

button.tool-button.button-hover .tool-icon {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.panel-hint {
  padding: 8rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

/* Inspector */
.inspector {
  padding: 0 var(--gutter) 40rpx;
}

.inspector-heading {
  padding: 24rpx 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}

.eyebrow {
  display: block;
  color: var(--color-text-3);
  font-size: 22rpx;
}

.inspector-title {
  display: block;
  margin-top: 2rpx;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

.compact-actions {
  display: flex;
  gap: 4rpx;
}

.compact-actions button {
  min-width: 80rpx;
  padding: 8rpx 10rpx;
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: var(--color-text-2);
  font-size: 20rpx;
}

.compact-actions button .icon {
  font-size: 36rpx;
}

.compact-actions .danger-text {
  color: var(--color-danger);
}

.property-section {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--color-divider);
}

.section-label {
  display: block;
  margin: 8rpx 0 16rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  font-weight: 500;
}

.text-area {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-body);
  line-height: 1.45;
}

.text-area.small {
  min-height: 72rpx;
}

.helper-text {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.6;
}

/* Segmented control: the selected option lifts onto a white pill. */
.segment-row {
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: var(--radius-md);
  display: flex;
  gap: 4rpx;
  background: var(--color-fill);
}

.segment-row button {
  min-width: 0;
  min-height: 60rpx;
  padding: 0 8rpx;
  flex: 1;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  font-size: var(--font-caption);
  white-space: nowrap;
}

.segment-row button.button-hover {
  background: rgba(255, 255, 255, 0.6);
}

.segment-row button.active {
  color: var(--color-text-1);
  background: var(--color-surface);
  box-shadow: 0 2rpx 6rpx rgba(31, 35, 41, 0.1);
  font-weight: 600;
}

.font-scroll,
.mode-scroll {
  width: 100%;
  margin: 12rpx 0 4rpx;
  white-space: nowrap;
}

.font-row,
.mode-row {
  padding: 4rpx 0 8rpx;
  display: inline-flex;
  gap: 12rpx;
}

.switch-row,
.stepper-row,
.copies-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--color-divider);
  color: var(--color-text-1);
  font-size: var(--font-body);
}

.switch-row switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.stepper-row text:first-child {
  flex: 1;
}

.stepper-row button,
.stepper button {
  width: 64rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: 30rpx;
}

.preview-value {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.preview-value text:last-child {
  color: var(--color-text-1);
  font-weight: 600;
}

.field-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.field-grid.four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.field-grid label {
  padding: 14rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--color-fill);
}

.field-grid label text {
  display: block;
  color: var(--color-text-3);
  font-size: 20rpx;
}

.field-grid input {
  height: 48rpx;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 600;
}

.style-actions {
  margin: 8rpx 0 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.style-actions button {
  min-width: 72rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.style-actions button .icon {
  font-size: 36rpx;
}

.style-actions button.active {
  border-color: var(--color-primary-line);
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.style-actions.wide button {
  min-width: 0;
  height: 68rpx;
  padding: 0 12rpx;
  flex: 1;
  font-size: 22rpx;
}

.style-actions.wide button .icon {
  font-size: 28rpx;
}

.multi-arrange .style-actions.wide {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

button.outline-wide {
  width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--color-text-1);
  background: var(--color-surface);
  font-size: var(--font-body);
}

button.outline-wide .icon {
  font-size: 32rpx;
}

.property-section .outline-wide + .outline-wide {
  margin-top: 12rpx;
}

.table-cell-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.table-cell-grid input {
  height: 68rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.simple-panel {
  height: calc(100% - 208rpx);
  padding: 32rpx var(--gutter);
  box-sizing: border-box;
}

.simple-title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

.simple-panel .outline-wide {
  margin-top: 16rpx;
}

/* Save is secondary; print stays the prominent primary action. */
.editor-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  height: 120rpx;
  padding: 16rpx var(--gutter);
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  align-items: center;
  gap: 20rpx;
  border-top: 1rpx solid var(--color-divider);
  background: var(--color-surface);
}

/* Sheets with a scrolling body: the list takes whatever height the header,
   optional cards and actions leave, so the actions are never clipped. */
.device-sheet,
.settings-sheet,
.layers-sheet,
.material-sheet,
.border-sheet {
  display: flex;
  flex-direction: column;
}

.device-list,
.settings-scroll,
.layer-list,
.asset-grid,
.border-grid {
  height: 0;
  flex: 1;
}

/* Printer sheet */
.device-sheet {
  height: 74vh;
}

button.device-item {
  width: 100%;
  min-height: 112rpx;
  padding: 16rpx 4rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  border-bottom: 1rpx solid var(--color-divider);
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: 36rpx;
}

.device-copy {
  min-width: 0;
  flex: 1;
}

.device-name {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-id {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-4);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
}

.device-chevron {
  color: var(--color-text-4);
  font-size: 28rpx;
}

.connected-card {
  margin-bottom: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--color-success);
  background: var(--color-success-soft);
  font-size: 22rpx;
}

.connected-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  font-size: 36rpx;
}

.connected-copy {
  min-width: 0;
  flex: 1;
}

.connected-name {
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-empty {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-align: center;
}

/* Print sheet */
.print-sheet {
  max-height: 88vh;
}

.warning-card,
.error-card {
  margin: 8rpx 0 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.error-card {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

.warning-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.warning-head .icon {
  font-size: 32rpx;
}

.warning-title {
  font-size: var(--font-body);
  font-weight: 600;
}

.warning-actions {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.warning-actions button {
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  color: var(--color-warning);
  background: var(--color-surface);
  font-size: 22rpx;
  font-weight: 500;
}

.print-summary view {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: var(--font-body);
}

.print-summary view text:first-child {
  color: var(--color-text-3);
}

.print-summary view text:last-child {
  color: var(--color-text-1);
  font-weight: 500;
  text-align: right;
}

.copies-row {
  border-bottom: 0;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.copies-input {
  width: 96rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-body);
  font-weight: 600;
  text-align: center;
}

.progress-card {
  margin-top: 16rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
  text-align: center;
}

.progress-track {
  height: 10rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--color-fill);
}

.progress-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  transition: width 0.2s;
}

.print-actions {
  margin-top: 24rpx;
}

/* Label and print settings sheet */
.settings-sheet {
  height: 84vh;
}

.settings-scroll {
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.settings-scroll .section-label {
  margin-top: 24rpx;
}

.settings-scroll slider {
  margin: 8rpx 8rpx 16rpx;
}

.settings-scroll .outline-wide {
  margin-top: 24rpx;
}

button.danger-outline.full {
  width: 100%;
  min-height: 80rpx;
  margin-top: 16rpx;
  border-radius: var(--radius-md);
}

/* Layers sheet */
.layers-sheet {
  height: 68vh;
}

button.layer-item {
  width: 100%;
  min-height: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 16rpx;
  text-align: left;
}

.layer-item + .layer-item {
  margin-top: 4rpx;
}

button.layer-item.active {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.layer-type {
  min-width: 88rpx;
  padding: 4rpx 12rpx;
  flex: none;
  box-sizing: border-box;
  border-radius: var(--radius-xs);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 20rpx;
  text-align: center;
}

.layer-item.active .layer-type {
  color: var(--color-primary);
  background: var(--color-surface);
}

.layer-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: var(--font-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.layer-state {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--color-text-4);
  font-size: 22rpx;
}

.layer-item.active .layer-state {
  color: var(--color-primary);
}

.layer-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  display: flex;
  gap: 12rpx;
  border-top: 1rpx solid var(--color-divider);
}

.layer-actions button {
  min-height: 72rpx;
  flex: 1;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.layer-actions .danger-text {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

/* Material and border sheets */
.material-sheet,
.border-sheet {
  height: 74vh;
}

.asset-grid button,
.border-grid button {
  position: relative;
  width: 25%;
  height: 172rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  vertical-align: top;
  color: var(--color-text-2);
  font-size: 22rpx;
}

.asset-grid image,
.asset-symbol,
.border-sample,
.border-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  background: var(--color-fill);
}

.asset-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  font-size: 48rpx;
}

.asset-vip {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #fff;
  background: #D48806;
  font-size: 18rpx;
}

.border-sample {
  border: 3rpx solid var(--color-text-1);
  box-sizing: border-box;
  background: #fff;
}

.border-grid button.active {
  color: var(--color-primary);
}

.border-grid button.active .border-sample,
.border-grid button.active .border-image {
  box-shadow: 0 0 0 4rpx var(--color-primary);
}

.border-sample.double { border-style: double; border-width: 8rpx; }
.border-sample.rounded { border-radius: 28rpx; }
.border-sample.dashed { border-style: dashed; }
.border-sample.thick { border-width: 8rpx; }

.online-asset-status {
  width: 100%;
  min-height: 88rpx;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 22rpx;
}

.online-asset-status.error {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

.asset-grid .online-asset-status button,
.border-grid .online-asset-status button {
  width: auto;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-full);
  display: flex;
  color: var(--color-text-1);
  background: var(--color-surface);
  font-size: 22rpx;
}

.recovery-title {
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

@media (max-height: 700px) {
  .editor-panel {
    height: 540rpx;
    min-height: 420rpx;
  }
  .canvas-stage {
    padding-top: 56rpx;
    padding-bottom: 56rpx;
  }
  button.tool-button {
    height: 124rpx;
  }
  .tool-icon {
    width: 72rpx;
    height: 72rpx;
    font-size: 40rpx;
  }
}
