/* Home shell: home, templates, projects, batch data and profile routes.
   Tokens, buttons, chips and bottom sheets live in app.wxss. */

.app-shell {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Fixed strip over the status bar and capsule row. At rest it matches what is
   behind it; once the page scrolls, content passes underneath instead of
   showing through the status bar. */
.top-cover {
  position: fixed;
  z-index: 30;
  top: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
}

.route-home .top-cover,
.route-profile .top-cover,
.route-templates .top-cover,
.route-projects .top-cover,
.route-data .top-cover {
  background: var(--color-bg);
}

.section-heading,
.inline-actions,
.data-toolbar {
  display: flex;
  align-items: center;
}

.section-heading {
  justify-content: space-between;
}

/* Home bar: the greeting sits beside the WeChat capsule and stays put while
   the page scrolls under the top cover. */
.home-bar {
  position: fixed;
  z-index: 31;
  left: var(--gutter);
  right: var(--gutter);
  height: 88rpx;
  display: flex;
  align-items: center;
  /* The capsule is about 174rpx wide with a 14rpx edge; the help button sits
     just to its left. */
  padding-right: 202rpx;
  justify-content: space-between;
}

.home-greet {
  min-width: 0;
}

.home-hello {
  display: block;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
  line-height: 1.3;
}

.home-name {
  display: block;
  color: var(--color-text-1);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

button.circle-button {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(21, 23, 28, 0.1);
  font-size: 40rpx;
  /* The plate stays 72rpx; the invisible ring gives the thumb a 44px target. */
  position: relative;
}

button.circle-button::after {
  content: '';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  border-radius: 50%;
}

/* Printer card: always the first thing on the page. White and green when
   connected; a dark card with a red button when it still needs a link. */
button.printer-card {
  position: relative;
  width: 100%;
  min-height: 168rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  overflow: hidden;
  text-align: left;
  color: var(--color-text-1);
  background: #fff;
  box-shadow: var(--shadow-card);
}

.printer-card.off {
  color: #fff;
  background: linear-gradient(135deg, #2A2F3B 0%, #15171C 100%);
  box-shadow: 0 16rpx 40rpx rgba(21, 23, 28, 0.22);
}

.printer-orb {
  position: absolute;
  top: -88rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.printer-card:not(.off) .printer-orb {
  display: none;
}

.printer-icon {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-success);
  background: var(--color-success-soft);
  font-size: 52rpx;
}

.printer-card.wait .printer-icon {
  color: var(--color-info);
  background: var(--color-info-soft);
}

.printer-card.off .printer-icon {
  color: #fff;
  background: rgba(255, 255, 255, 0.12);
}

.printer-dot {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: var(--color-success);
  box-sizing: border-box;
}

.printer-copy {
  min-width: 0;
  flex: 1;
}

.printer-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.printer-title {
  min-width: 0;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.printer-pill {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-small, 22rpx);
  font-weight: 500;
  line-height: 44rpx;
}

.printer-pill.ok {
  color: var(--color-success-text);
  background: var(--color-success-soft);
}

.printer-pill.wait {
  color: var(--color-info-text);
  background: var(--color-info-soft);
}

.printer-sub {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.printer-card.off .printer-sub {
  color: #B4B9C6;
}

.printer-action {
  flex: none;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-caption);
  font-weight: 500;
}

.printer-card.off .printer-action {
  color: #fff;
  background: var(--color-primary);
  font-weight: 700;
}

.printer-action .icon {
  font-size: 1.15em;
}

/* Bento tiles: new label is the big red one. */
.bento {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

button.bento-new {
  position: relative;
  width: calc(50% - 12rpx);
  height: 320rpx;
  flex: none;
  border-radius: 44rpx;
  overflow: hidden;
  text-align: left;
  color: #fff;
  background: linear-gradient(155deg, #F04A3E 0%, #D92A22 55%, #C21D17 100%);
  box-shadow: 0 16rpx 40rpx rgba(224, 45, 38, 0.25);
}

.bento-plus {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  background: #fff;
  font-size: 48rpx;
}

image.bento-deco {
  position: absolute;
  top: 40rpx;
  left: 160rpx;
  width: 168rpx;
  height: 124rpx;
  transform: rotate(10deg);
  filter: drop-shadow(0 12rpx 20rpx rgba(80, 0, 0, 0.25));
}

.bento-new-copy {
  position: absolute;
  left: 32rpx;
  right: 24rpx;
  bottom: 32rpx;
}

.bento-new-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.bento-new-note {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: var(--font-small, 22rpx);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bento-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.bento-row {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

button.tile {
  min-width: 0;
  flex: 1;
  height: 148rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  background: #fff;
  box-shadow: var(--shadow-card);
}

button.tile.wide {
  height: 128rpx;
}

button.tile.button-hover {
  background: var(--color-fill);
}

.tile-icon {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.tile-icon.small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  font-size: 36rpx;
}

.tile-icon.info {
  color: var(--color-info);
  background: var(--color-info-soft);
}

.tile-icon.warn {
  color: var(--color-warning);
  background: var(--color-warning-soft);
}

.tile-icon.violet {
  color: var(--color-violet);
  background: var(--color-violet-soft);
}

.tile-icon.neutral {
  color: var(--color-text-3);
  background: var(--color-fill);
}

.tile-copy {
  min-width: 0;
  flex: 1;
}

.tile-title {
  display: block;
  color: var(--color-text-1);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.tile-note {
  display: block;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-warning {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--color-warning-text);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.stock-warning .icon {
  flex: none;
  margin-top: 4rpx;
}

/* Continue-editing bar */
.draft-bar {
  margin-top: 24rpx;
  height: 144rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.draft-bar .draft-icon {
  width: 88rpx;
  height: 72rpx;
  border-radius: 20rpx;
}

.draft-title {
  display: block;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-meta {
  display: block;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button.draft-discard {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 32rpx;
}

button.draft-discard::after {
  content: '';
  position: absolute;
  top: -12rpx;
  right: -6rpx;
  bottom: -12rpx;
  left: -6rpx;
}

button.draft-go {
  height: 68rpx;
  padding: 0 28rpx;
  flex: none;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  color: #fff;
  background: var(--color-text-1);
  font-size: var(--font-caption);
  font-weight: 700;
}

/* Recent labels scroll sideways */
.recent-scroll {
  width: calc(100% + var(--gutter));
  white-space: nowrap;
}

.recent-row {
  display: inline-flex;
  gap: 24rpx;
  padding-right: var(--gutter);
}

.recent-card {
  width: 300rpx;
  flex: none;
  padding: 12rpx;
  border-radius: var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow-card);
}

button.recent-open {
  width: 100%;
  display: block;
  text-align: left;
}

.recent-thumb {
  height: 192rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.recent-foot {
  padding: 8rpx 0 4rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recent-copy {
  min-width: 0;
  flex: 1;
}

/* A round printer button: reopen this label and print it again. The plate is
   68rpx; the invisible ring around it makes the 44px touch target. */
button.recent-print {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-pressed);
  background: var(--color-primary-soft);
  font-size: 32rpx;
}

button.recent-print::after {
  content: '';
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  left: -10rpx;
  border: 0;
  border-radius: 50%;
}

button.recent-print.button-hover {
  background: var(--color-primary-line);
}

/* Content */
.home-content,
.route-content {
  padding: 24rpx var(--gutter) 48rpx;
}

.section-block {
  margin-top: 40rpx;
}

.section-heading {
  min-height: 64rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  color: var(--color-text-1);
  font-size: 32rpx;
  font-weight: 600;
}

.inline-actions {
  gap: 16rpx;
}

.heading-copy {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-note {
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-title {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Which printers print the template; amber when the user's printer cannot. */
.card-fit {
  max-width: 100%;
  height: 40rpx;
  margin-top: 10rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  overflow: hidden;
  color: var(--color-success-text, #137A4A);
  background: var(--color-success-soft);
  font-size: var(--font-small, 22rpx);
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-fit.mismatch {
  color: var(--color-warning-text, #8A5200);
  background: var(--color-warning-soft);
}

.card-blurb {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.eyebrow {
  display: block;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.muted {
  display: block;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

/* Draft recovery */
.draft-recovery {
  margin-top: 8rpx;
  padding: 28rpx;
}

.draft-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.draft-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  font-size: 36rpx;
}

.draft-copy {
  min-width: 0;
  flex: 1;
}

.draft-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.damage-notice,
.save-failed {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-warning-text, #8A5200);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.save-failed {
  margin: 0 0 20rpx;
}

.damage-notice .icon,
.save-failed .icon {
  flex: none;
  font-size: 32rpx;
}

.damage-copy {
  min-width: 0;
  flex: 1;
}

.damage-notice button,
.save-failed button {
  flex: none;
}

/* Project and template cards */
.project-grid,
.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.project-card,
.template-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: left;
}

button.project-open,
button.template-card {
  width: 100%;
  display: block;
  text-align: left;
}

.project-thumb,
.template-thumb {
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.template-thumb image {
  width: calc(100% - 40rpx);
  height: 172rpx;
}

.library-thumb {
  height: 228rpx;
}

.library-thumb image {
  height: 196rpx;
}

.project-card-copy,
.template-copy {
  padding: 18rpx 20rpx 22rpx;
}

/* The project card's copy row holds the text and the delete button side by side,
   so deleting never sits on the thumbnail the way it used to. */
.project-card-copy {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.project-card-text {
  flex: 1;
  min-width: 0;
}

button.project-delete {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 28rpx;
}

button.project-delete.button-hover {
  color: var(--color-primary-pressed);
  background: var(--color-danger-soft);
}

/* Source label (原创 / 授权改编 / 商跃生成) sits in the meta row so it never
   covers the thumbnail artwork. */
.template-meta {
  min-width: 0;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.template-meta .card-meta {
  min-width: 0;
  margin-top: 0;
}

.template-badge {
  flex: none;
  padding: 0 8rpx;
  border-radius: 6rpx;
  /* Red on the soft red fill: the brand red reaches only 4.18:1 there. */
  color: var(--color-primary-pressed);
  background: var(--color-primary-soft);
  font-size: var(--font-tiny);
  font-weight: 500;
  line-height: 32rpx;
}

.abstract-preview {
  position: relative;
  width: 72%;
  height: 128rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.08);
}

.preview-line {
  width: 46%;
  height: 8rpx;
  margin: 20rpx 0 0 16rpx;
  border-radius: 4rpx;
  background: var(--color-text-1);
}

.preview-line.wide {
  width: 68%;
  height: 12rpx;
}

.preview-code {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  height: 36rpx;
  opacity: 0.85;
  background: repeating-linear-gradient(90deg, #1F2329 0 3rpx, transparent 3rpx 7rpx, #1F2329 7rpx 12rpx, transparent 12rpx 15rpx);
}

.kind-qr .preview-code {
  left: auto;
  width: 44rpx;
  height: 44rpx;
  background: repeating-conic-gradient(#1F2329 0 25%, transparent 0 50%) 0 / 11rpx 11rpx;
}

.kind-accent .preview-code {
  height: 3rpx;
  background: var(--color-text-1);
}

/* Empty states */
.friendly-empty {
  min-height: 280rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.friendly-empty .glyph-badge {
  margin-bottom: 8rpx;
}

.friendly-empty > .primary-button {
  margin-top: 20rpx;
}

.empty-actions {
  width: 100%;
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.empty-actions button {
  flex: 1;
  padding: 0 16rpx;
}

.tall-empty {
  min-height: 560rpx;
}

/* Secondary route header and toolbar */
.plain-header {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--color-bg);
}

.header-copy {
  min-width: 0;
}

.header-lead {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* Back to 我的: the data route is entered from there and is not a page of
   its own, so the system back gesture would leave the mini program. */
button.back-button {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-left: -16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-1);
  font-size: 40rpx;
}

.back-icon {
  transform: rotate(180deg);
}

.plain-title {
  display: block;
  color: var(--color-text-1);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
}

.plain-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.page-toolbar {
  padding: 0 var(--gutter) 16rpx;
  background: var(--color-bg);
}

.search-box {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--color-text-4);
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(21, 23, 28, 0.05);
  font-size: 36rpx;
}

.search-box input {
  flex: 1;
  height: 100%;
  color: var(--color-text-1);
  font-size: var(--font-body);
}

.search-placeholder {
  color: var(--color-text-4);
}

.filter-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: var(--gutter);
}

.tab-scroll {
  margin-top: 8rpx;
}

.tab-row {
  align-items: flex-start;
  gap: 12rpx;
}

/* First-level filter: a row of icon tiles. The chosen one fills with red. */
button.cat-tile {
  width: 104rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-1);
  font-size: var(--font-small, 22rpx);
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.cat-label {
  max-width: 104rpx;
  overflow: hidden;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button.cat-tile.tone-amber .cat-icon { color: var(--color-warning); background: var(--color-warning-soft); }
button.cat-tile.tone-red .cat-icon { color: var(--color-primary-pressed); background: var(--color-primary-soft); }
button.cat-tile.tone-violet .cat-icon { color: var(--color-violet); background: var(--color-violet-soft); }
button.cat-tile.tone-blue .cat-icon { color: var(--color-info); background: var(--color-info-soft); }
button.cat-tile.tone-green .cat-icon { color: var(--color-success); background: var(--color-success-soft); }
button.cat-tile.tone-neutral .cat-icon { color: var(--color-text-3); background: var(--color-fill-strong); }

button.cat-tile.active {
  font-weight: 700;
}

/* Chosen: filled red with a white glyph (the shape and weight change too). */
button.cat-tile.active .cat-icon {
  color: #fff;
  background: var(--color-primary);
  box-shadow: var(--shadow-primary);
}

button.cat-tile.button-hover {
  opacity: 0.7;
}

/* Clear the search in one tap. The plate is 56rpx; the ring makes it 88rpx. */
button.search-clear {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  margin-right: -12rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 28rpx;
}

button.search-clear::after {
  content: '';
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  border: 0;
  border-radius: 50%;
}

/* 只看…能打印的 is an on/off setting, so it gets a switch of its own instead of
   sitting among the single-choice chips. */
.family-row {
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 8rpx 0 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(21, 23, 28, 0.05);
  font-size: var(--font-caption);
}

.family-copy {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text-1);
}

.family-copy .icon {
  flex: none;
  color: var(--color-success);
  font-size: 32rpx;
}

.family-row switch {
  transform: scale(0.82);
  transform-origin: right center;
}

/* A handful of categories wraps onto a second line instead of hiding off the
   edge; long scene and size rows scroll and fade out on the right. */
.chip-wrap {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-scroll.fade {
  -webkit-mask-image: linear-gradient(90deg, #000 0, #000 86%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0, #000 86%, transparent 100%);
}

.chip-count {
  margin-left: 8rpx;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
  font-weight: 400;
}

.chip.active .chip-count {
  color: rgba(255, 255, 255, 0.72);
}

/* What the filters leave, and the way back to everything. */
.result-bar {
  min-height: 72rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.result-text {
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-actions {
  flex: none;
  display: flex;
  gap: 8rpx;
}

.result-actions .text-button {
  color: var(--color-text-1);
  font-weight: 700;
}

.template-content {
  padding-top: 8rpx;
}

/* Cards answer a press at once (smaller and slightly faded). */
.template-card {
  transition: transform 0.12s ease-out, opacity 0.12s ease-out;
}

.card-pressed {
  transform: scale(0.97);
  opacity: 0.85;
}

.load-more-row {
  margin-top: 24rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.load-more-row.end {
  justify-content: center;
}

button.load-more {
  flex: none;
}

.suggest-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.suggest-label {
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.suggest-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  background: var(--color-fill);
  box-shadow: none;
}

/* Brings the filters back once they scrolled away; sits above the tab bar. */
button.back-top {
  position: fixed;
  z-index: 39;
  right: var(--gutter);
  bottom: calc(176rpx + env(safe-area-inset-bottom));
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff;
  background: var(--color-text-1);
  box-shadow: 0 12rpx 28rpx rgba(21, 23, 28, 0.24);
  font-size: var(--font-caption);
  font-weight: 700;
}

/* Batch data */
.data-toolbar {
  gap: 16rpx;
}

.data-hint {
  display: block;
  margin: 12rpx 0 20rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.5;
}

/* A long table scrolls inside this box instead of pushing the 批量打印 card off
   the page: 1000 rows used to make the whole page about 4 万 rpx tall. */
.data-table-scroll {
  width: 100%;
  max-height: 52vh;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.data-table {
  width: 1164rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.data-row {
  min-height: 80rpx;
  display: grid;
  grid-template-columns: 64rpx 230rpx 260rpx 180rpx 240rpx 80rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-divider);
}

.data-row:last-child {
  border-bottom: 0;
}

/* The row number the error messages talk about. */
.row-index {
  color: var(--color-text-3);
  font-size: var(--font-small);
  text-align: center;
}

/* Rows outside the rendered window keep their height, so the scrollbar and the
   scroll position stay honest while only ~60 rows exist as nodes. */
.data-row-spacer {
  width: 100%;
}

.data-row input {
  height: 64rpx;
  margin: 6rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-fill);
  box-sizing: border-box;
  font-size: var(--font-caption);
}

.data-header {
  min-height: 64rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  font-weight: 500;
}

.data-header text {
  padding-left: 22rpx;
}

button.row-remove {
  width: 80rpx;
  height: 80rpx;
  justify-self: center;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 32rpx;
}

.batch-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.batch-card .muted {
  margin-top: 6rpx;
}

.batch-card .picker-field,
.batch-card .full-button {
  margin-top: 24rpx;
}

.batch-card .batch-secondary {
  margin-top: 16rpx;
}

.batch-card .batch-room {
  margin-top: 12rpx;
}

/* Profile */
.profile-hero {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: 16rpx;
  gap: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(155deg, #F04A3E, #C21D17);
  font-size: 48rpx;
  font-weight: 700;
}

.profile-card {
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-card .plain-title {
  font-size: 36rpx;
}

button.profile-account-button.outline-button {
  color: #fff;
  background: var(--color-text-1);
  font-weight: 700;
}

.profile-copy {
  min-width: 0;
  flex: 1;
}

button.profile-account-button {
  flex: none;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: var(--font-caption);
}

.account-device-note {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-4);
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  background: var(--color-fill);
  color: var(--color-text-2);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.account-device-note .icon {
  flex: none;
  font-size: 40rpx;
}

.profile-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.local-badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--color-success-text, #137A4A);
  background: var(--color-success-soft);
  font-size: var(--font-tiny);
  font-weight: 500;
}

.stats-row {
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  background: transparent;
  box-shadow: none;
}

.stats-row view {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
  border-radius: var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow-card);
}

.stats-row view text:first-child {
  color: var(--color-text-1);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.stats-row view text:last-child {
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.menu-section {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-section button {
  position: relative;
  width: 100%;
  min-height: 112rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
  color: var(--color-text-1);
  font-size: var(--font-body);
}

/* Inset divider that starts after the icon column. */
.menu-section button + button::before {
  content: "";
  position: absolute;
  top: 0;
  left: 128rpx;
  right: 0;
  height: 1rpx;
  background: var(--color-divider);
}

.menu-section button > view {
  min-width: 0;
  flex: 1;
}

.menu-section button > view > text:first-child {
  display: block;
}

.menu-section button > view.menu-tile {
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  flex: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
}

.menu-section button > view.menu-tile.tile-printer { color: var(--color-success); background: var(--color-success-soft); }
.menu-section button > view.menu-tile.tile-sliders-horizontal,
.menu-section button > view.menu-tile.tile-circle-help { color: var(--color-info); background: var(--color-info-soft); }
.menu-section button > view.menu-tile.tile-history { color: var(--color-violet); background: var(--color-violet-soft); }
.menu-section button > view.menu-tile.tile-sheet { color: var(--color-warning); background: var(--color-warning-soft); }

.menu-icon {
  color: inherit;
  font-size: 40rpx;
}

.menu-note {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-chevron {
  color: var(--color-text-4);
  font-size: 28rpx;
}

.privacy-note {
  display: block;
  margin: 32rpx 16rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.7;
  text-align: center;
}

/* Bottom navigation: a floating pill with the four places. New labels start
   from the home page's red tile, so there is no centre button. */
.bottom-nav {
  position: fixed;
  z-index: 40;
  left: var(--gutter);
  right: var(--gutter);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 128rpx;
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  border-radius: 64rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(21, 23, 28, 0.12), 0 2rpx 4rpx rgba(21, 23, 28, 0.06);
  box-sizing: border-box;
}

.bottom-nav button {
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-small, 22rpx);
}

.bottom-nav button.button-hover {
  background: transparent;
  opacity: 0.7;
}

.bottom-nav button.active {
  color: var(--color-primary);
  font-weight: 700;
}

.nav-icon {
  font-size: 44rpx;
}

/* Modal layers: sheets and backdrop are fixed (app.wxss); the layer only
   lifts them above the bottom navigation. */
.modal-layer {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.sheet-heading-copy {
  min-width: 0;
}

/* The printer picker draws its own fixed sheet; this lifts it above the
   bottom navigation like .modal-layer, without covering the page when closed. */
.picker-layer {
  position: relative;
  z-index: 100;
}

.large-template-preview {
  height: 380rpx;
  margin-top: 8rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.large-template-preview image {
  width: calc(100% - 64rpx);
  height: 332rpx;
}

.large-template-preview .abstract-preview {
  width: 60%;
  height: 220rpx;
}

.preview-blurb {
  display: block;
  margin: 24rpx 0 16rpx;
  color: var(--color-text-2);
  font-size: var(--font-body);
  line-height: 1.55;
}

.preview-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-meta text {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.preview-meta .meta-badge {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.fit-notice {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  gap: 12rpx;
  color: var(--color-warning-text, #8A5200);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.fit-notice .icon {
  flex: none;
  margin-top: 6rpx;
  font-size: 30rpx;
}

/* Paper presets */
.preset-grid {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.preset-grid button {
  position: relative;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
  text-align: left;
  background: var(--color-fill);
}

.preset-grid button.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.preset-size {
  color: var(--color-text-1);
  font-size: 32rpx;
  font-weight: 600;
}

.preset-grid button.active .preset-size {
  color: var(--color-primary);
}

.preset-name {
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.preset-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  color: var(--color-primary);
  font-size: 32rpx;
}

.custom-size {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.custom-size label {
  display: block;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.custom-size input {
  height: 52rpx;
  margin-top: 4rpx;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

/* Print history */
.history-list {
  max-height: 62vh;
  margin-top: 8rpx;
}

.history-item {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.history-status {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 30rpx;
}

.history-status.success {
  /* Words, not icons: the base green is 3.1:1 on this fill, the text green 4.85:1. */
  color: var(--color-success-text);
  background: var(--color-success-soft);
}

.history-status.failed,
.history-status.error {
  /* 4.18:1 with the brand red; the pressed red reaches 5.3:1. */
  color: var(--color-primary-pressed);
  background: var(--color-danger-soft);
}

.history-time {
  display: block;
  margin-top: 2rpx;
  color: var(--color-text-3);
  font-size: var(--font-small);
}

/* A failure reason is the reason the owner came back for; two lines, not one
   clipped line. The row opens the full text in a dialog. */
.history-message {
  display: -webkit-box;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  white-space: normal;
}

.history-message.failed,
.history-message.error {
  color: var(--color-warning-text);
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-name {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button.history-action {
  min-height: 64rpx;
  padding: 0 24rpx;
  flex: none;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  color: var(--color-text-2);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

/* A record without a copy of the label: plain grey words, not a button. */
.history-no-copy {
  flex: none;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.history-more {
  display: block;
  padding: 24rpx 0 8rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-align: center;
}

.sheet-empty {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

/* Default print settings */
.setting-row {
  margin-top: 24rpx;
}

.setting-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
}

.setting-value {
  color: var(--color-primary);
  font-weight: 600;
}

.setting-row slider {
  margin: 12rpx 8rpx;
}

.setting-help {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.setting-row .picker-field {
  margin-top: 12rpx;
}

/* Help */
.help-scroll {
  max-height: 68vh;
}

.help-copy {
  padding-bottom: 12rpx;
}

.help-copy > text {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-2);
  font-size: var(--font-body);
  line-height: 1.65;
}

.help-copy > .help-heading {
  margin-top: 28rpx;
  color: var(--color-text-1);
  font-weight: 600;
}

.help-warning {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  gap: 12rpx;
  color: var(--color-warning-text, #8A5200);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.help-warning .icon {
  margin-top: 6rpx;
  font-size: 30rpx;
}

/* First-run onboarding */
.onboarding-layer {
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.onboarding-card {
  position: relative;
  z-index: 21;
  width: 100%;
  padding: 40rpx 40rpx 36rpx;
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--color-surface);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  animation: card-in 0.24s ease-out;
}

@keyframes card-in {
  from { transform: scale(0.96); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.onboarding-dots {
  display: flex;
  gap: 8rpx;
}

.onboarding-dots text {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-fill-strong);
  transition: width 0.2s;
}

.onboarding-dots text.active {
  width: 36rpx;
  background: var(--color-primary);
}

.onboarding-icon {
  margin: 40rpx 0 28rpx;
}

.onboarding-title {
  display: block;
  color: var(--color-text-1);
  font-size: 38rpx;
  font-weight: 600;
}

.onboarding-copy {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-3);
  font-size: var(--font-body);
  line-height: 1.6;
}

.onboarding-actions {
  width: 100%;
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: 20rpx;
}

/* The last step has only 开始使用. */
.onboarding-actions.single {
  grid-template-columns: minmax(0, 1fr);
}

@media (min-width: 700px) {
  .home-content,
  .route-content,
  .brand-row,
  .plain-header,
  .page-toolbar,
  .profile-hero {
    max-width: 980rpx;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }
  .project-grid,
  .template-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* Live label previews (core/mini-preview.js): drawn large, scaled down. */
.mini-frame {
  position: relative;
  flex: none;
  overflow: hidden;
  border-radius: 6rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.1);
}

.mini-label {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
  background: #fff;
}

.mini-node {
  position: absolute;
  box-sizing: border-box;
  overflow: hidden;
  color: #000;
}

.mini-node.text {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: sans-serif;
}

.mini-node.reverse,
.mini-node.fill,
.mini-node.line {
  background: #000;
}

.mini-node.reverse {
  color: #fff;
}

.mini-node.stroke {
  border: 1px solid #000;
}

.mini-node.line.dashed {
  background: repeating-linear-gradient(90deg, #000 0, #000 6px, transparent 6px, transparent 10px);
}

.mini-node.code {
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* A picture's place in a thumbnail (pictures are not loaded for previews). */
.mini-node.picture {
  border: 1px dashed #B8BCC4;
  background: #E8EAED;
}
