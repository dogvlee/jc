/* Home shell: home, templates, projects, batch data and profile routes.
   Tokens, buttons, chips and bottom sheets live in app.wxss. */

.app-shell {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Soft brand wash behind the header, fading into the page background. */
.route-home,
.route-profile {
  background: linear-gradient(180deg, #FFE4E0 0, #FFF2F0 280rpx, var(--color-bg) 560rpx);
}

/* Fixed strip over the status bar and capsule row. At rest it matches what is
   behind it; once the page scrolls, content passes underneath instead of
   showing through the status bar. */
.top-cover {
  position: fixed;
  z-index: 30;
  top: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
}

.route-home .top-cover,
.route-profile .top-cover {
  background: linear-gradient(180deg, #FFE4E0 0, #FFF2F0 280rpx);
}

.brand-row,
.brand-lockup,
.hero-actions,
.section-heading,
.inline-actions,
.stock-card,
.data-toolbar,
.profile-hero {
  display: flex;
  align-items: center;
}

.brand-row,
.section-heading {
  justify-content: space-between;
}

/* Header */
.home-hero {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: 8rpx;
}

.brand-lockup {
  min-width: 0;
  gap: 20rpx;
}

.brand-mark {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--color-primary);
  box-shadow: var(--shadow-primary);
  font-size: 36rpx;
  font-weight: 600;
}

.brand-copy {
  min-width: 0;
}

.brand-title {
  display: block;
  color: var(--color-text-1);
  font-size: 36rpx;
  font-weight: 600;
}

.brand-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.hero-actions {
  flex: none;
  gap: 16rpx;
}

button.circle-button {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  background: rgba(255, 255, 255, 0.78);
  font-size: 36rpx;
}

button.device-pill {
  min-height: 64rpx;
  padding: 0 16rpx 0 20rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-1);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  font-size: var(--font-caption);
  font-weight: 500;
  white-space: nowrap;
}

.device-pill .icon {
  color: var(--color-text-3);
  font-size: 32rpx;
}

.device-pill .device-chevron {
  color: var(--color-text-4);
  font-size: 24rpx;
}

.device-pill.connected,
.device-pill.connected .icon {
  color: var(--color-success);
}

.device-label {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Content */
.home-content,
.route-content {
  padding: 24rpx var(--gutter) 48rpx;
}

.section-block {
  margin-top: 40rpx;
}

.section-heading {
  min-height: 64rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  color: var(--color-text-1);
  font-size: 32rpx;
  font-weight: 600;
}

.inline-actions {
  gap: 16rpx;
}

.card-title {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-blurb {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.eyebrow {
  display: block;
  color: var(--color-text-3);
  font-size: 22rpx;
}

.muted {
  display: block;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

/* Draft recovery */
.draft-recovery {
  margin-top: 8rpx;
  padding: 28rpx;
}

.draft-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.draft-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  font-size: 36rpx;
}

.draft-copy {
  min-width: 0;
  flex: 1;
}

.draft-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

/* Project and template cards */
.project-grid,
.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.project-card,
.template-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: left;
}

button.project-open,
button.template-card {
  width: 100%;
  display: block;
  text-align: left;
}

.project-thumb,
.template-thumb {
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.template-thumb image {
  width: calc(100% - 40rpx);
  height: 172rpx;
}

.library-thumb {
  height: 228rpx;
}

.library-thumb image {
  height: 196rpx;
}

.project-card-copy,
.template-copy {
  padding: 18rpx 20rpx 22rpx;
}

/* Source label (原创 / 授权改编 / 商跃生成) sits in the meta row so it never
   covers the thumbnail artwork. */
.template-meta {
  min-width: 0;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.template-meta .card-meta {
  min-width: 0;
  margin-top: 0;
}

.template-badge {
  flex: none;
  padding: 0 8rpx;
  border-radius: 6rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: var(--font-tiny);
  font-weight: 500;
  line-height: 32rpx;
}

.abstract-preview {
  position: relative;
  width: 72%;
  height: 128rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.08);
}

.preview-line {
  width: 46%;
  height: 8rpx;
  margin: 20rpx 0 0 16rpx;
  border-radius: 4rpx;
  background: var(--color-text-1);
}

.preview-line.wide {
  width: 68%;
  height: 12rpx;
}

.preview-code {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  height: 36rpx;
  opacity: 0.85;
  background: repeating-linear-gradient(90deg, #1F2329 0 3rpx, transparent 3rpx 7rpx, #1F2329 7rpx 12rpx, transparent 12rpx 15rpx);
}

.kind-qr .preview-code {
  left: auto;
  width: 44rpx;
  height: 44rpx;
  background: repeating-conic-gradient(#1F2329 0 25%, transparent 0 50%) 0 / 11rpx 11rpx;
}

.kind-accent .preview-code {
  height: 3rpx;
  background: var(--color-text-1);
}

/* Empty states */
.friendly-empty {
  min-height: 280rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.friendly-empty .glyph-badge {
  margin-bottom: 8rpx;
}

.friendly-empty > .primary-button {
  margin-top: 20rpx;
}

.empty-actions {
  width: 100%;
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.empty-actions button {
  flex: 1;
  padding: 0 16rpx;
}

.tall-empty {
  min-height: 560rpx;
}

/* Current paper */
.stock-card {
  margin-top: 24rpx;
  padding: 24rpx;
  gap: 24rpx;
}

.stock-preview {
  width: 112rpx;
  height: 88rpx;
  flex: none;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.stock-paper {
  width: 72rpx;
  height: 40rpx;
  border-radius: 6rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.16);
}

.stock-copy {
  min-width: 0;
  flex: 1;
}

.stock-name {
  display: block;
  margin: 4rpx 0;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-actions {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* Scan-to-label strip */
button.scan-banner {
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.scan-symbol {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: 40rpx;
}

.scan-copy {
  min-width: 0;
  flex: 1;
}

.scan-title {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

.scan-note {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  line-height: 1.45;
}

.scan-cta {
  flex: none;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: var(--font-caption);
  font-weight: 500;
}

/* Secondary route header and toolbar */
.plain-header {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--color-surface);
}

.route-data .plain-header {
  border-bottom: 1rpx solid var(--color-divider);
}

.header-copy {
  min-width: 0;
}

.plain-title {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-display);
  font-weight: 600;
}

.plain-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.page-toolbar {
  padding: 4rpx var(--gutter) 16rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.search-box {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-text-4);
  background: var(--color-fill);
  font-size: 32rpx;
}

.search-box input {
  flex: 1;
  height: 100%;
  color: var(--color-text-1);
  font-size: var(--font-body);
}

.search-placeholder {
  color: var(--color-text-4);
}

.filter-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: var(--gutter);
}

.tab-scroll {
  margin-top: 8rpx;
}

.tab-row {
  gap: 40rpx;
}

/* First-level filter: text tabs with a short brand underline. ::before is
   used because buttons already draw their border with ::after. */
button.filter-tab {
  position: relative;
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  color: var(--color-text-3);
  font-size: var(--font-body);
}

button.filter-tab.active {
  color: var(--color-text-1);
  font-weight: 600;
}

button.filter-tab.active::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 32rpx;
  height: 6rpx;
  margin-left: -16rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
}

.template-content {
  padding-top: 24rpx;
}

button.load-more {
  margin-top: 24rpx;
}

/* Projects */
button.delete-card {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
}

/* Batch data */
.data-toolbar {
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.data-table-scroll {
  width: 100%;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.data-table {
  width: 1100rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.data-row {
  min-height: 80rpx;
  display: grid;
  grid-template-columns: 230rpx 260rpx 180rpx 240rpx 80rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-divider);
}

.data-row:last-child {
  border-bottom: 0;
}

.data-row input {
  height: 64rpx;
  margin: 6rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-fill);
  box-sizing: border-box;
  font-size: var(--font-caption);
}

.data-header {
  min-height: 64rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
  font-weight: 500;
}

.data-header text {
  padding-left: 22rpx;
}

button.row-remove {
  width: 64rpx;
  height: 64rpx;
  justify-self: center;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  font-size: 32rpx;
}

.batch-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.batch-card .muted {
  margin-top: 6rpx;
}

.batch-card .picker-field,
.batch-card .full-button {
  margin-top: 24rpx;
}

/* Profile */
.profile-hero {
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  padding-bottom: 16rpx;
  gap: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--color-primary);
  box-shadow: var(--shadow-primary);
  font-size: 48rpx;
  font-weight: 600;
}

.profile-copy {
  min-width: 0;
}

.profile-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.local-badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--color-success);
  background: var(--color-success-soft);
  font-size: var(--font-tiny);
  font-weight: 500;
}

.stats-row {
  padding: 28rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.stats-row view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 1rpx solid var(--color-divider);
}

.stats-row view:last-child {
  border-right: 0;
}

.stats-row view text:first-child {
  color: var(--color-text-1);
  font-size: 40rpx;
  font-weight: 600;
}

.stats-row view text:last-child {
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

.menu-section {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-section button {
  position: relative;
  width: 100%;
  min-height: 112rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
  color: var(--color-text-1);
  font-size: var(--font-body);
}

/* Inset divider that starts after the icon column. */
.menu-section button + button::before {
  content: "";
  position: absolute;
  top: 0;
  left: 96rpx;
  right: 0;
  height: 1rpx;
  background: var(--color-divider);
}

.menu-section button > view {
  min-width: 0;
  flex: 1;
}

.menu-section button > view > text:first-child {
  display: block;
}

.menu-icon {
  color: var(--color-text-2);
  font-size: 40rpx;
}

.menu-note {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: var(--font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-chevron {
  color: var(--color-text-4);
  font-size: 28rpx;
}

.privacy-note {
  display: block;
  margin: 32rpx 16rpx;
  color: var(--color-text-4);
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

/* Bottom navigation */
.bottom-nav {
  position: fixed;
  z-index: 40;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 0 16rpx env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-divider);
  box-sizing: border-box;
}

.bottom-nav button {
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-tiny);
}

.bottom-nav button.button-hover {
  background: transparent;
  opacity: 0.7;
}

.bottom-nav button.active {
  color: var(--color-primary);
  font-weight: 600;
}

.nav-icon {
  font-size: 44rpx;
}

.bottom-nav .create-nav {
  width: 96rpx;
  height: 96rpx;
  min-height: 96rpx;
  margin-top: -28rpx;
  align-self: start;
  justify-self: center;
  border: 8rpx solid #fff;
  border-radius: 50%;
  color: #fff;
  background: var(--color-primary);
  box-shadow: var(--shadow-primary);
  box-sizing: border-box;
  font-size: 44rpx;
}

.bottom-nav .create-nav.button-hover {
  opacity: 1;
  background: var(--color-primary-pressed);
}

/* Modal layers: sheets and backdrop are fixed (app.wxss); the layer only
   lifts them above the bottom navigation. */
.modal-layer {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.sheet-heading-copy {
  min-width: 0;
}

.large-template-preview {
  height: 380rpx;
  margin-top: 8rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-fill);
}

.large-template-preview image {
  width: calc(100% - 64rpx);
  height: 332rpx;
}

.large-template-preview .abstract-preview {
  width: 60%;
  height: 220rpx;
}

.preview-blurb {
  display: block;
  margin: 24rpx 0 16rpx;
  color: var(--color-text-2);
  font-size: var(--font-body);
  line-height: 1.55;
}

.preview-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-meta text {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 22rpx;
}

.preview-meta .meta-badge {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

/* Paper presets */
.preset-grid {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.preset-grid button {
  position: relative;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
  text-align: left;
  background: var(--color-fill);
}

.preset-grid button.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.preset-size {
  color: var(--color-text-1);
  font-size: 32rpx;
  font-weight: 600;
}

.preset-grid button.active .preset-size {
  color: var(--color-primary);
}

.preset-name {
  color: var(--color-text-3);
  font-size: 22rpx;
}

.preset-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  color: var(--color-primary);
  font-size: 32rpx;
}

.custom-size {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.custom-size label {
  display: block;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 22rpx;
}

.custom-size input {
  height: 52rpx;
  margin-top: 4rpx;
  color: var(--color-text-1);
  font-size: var(--font-subtitle);
  font-weight: 600;
}

/* Print history */
.history-list {
  max-height: 62vh;
  margin-top: 8rpx;
}

.history-item {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.history-status {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
  font-size: 30rpx;
}

.history-status.success {
  color: var(--color-success);
  background: var(--color-success-soft);
}

.history-status.failed,
.history-status.error {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-name {
  display: block;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

button.history-action {
  min-height: 56rpx;
  padding: 0 20rpx;
  flex: none;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  color: var(--color-text-2);
  background: var(--color-fill);
  font-size: var(--font-caption);
}

.sheet-empty {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

/* Default print settings */
.setting-row {
  margin-top: 24rpx;
}

.setting-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: 500;
}

.setting-value {
  color: var(--color-primary);
  font-weight: 600;
}

.setting-row slider {
  margin: 12rpx 8rpx;
}

.setting-row .picker-field {
  margin-top: 12rpx;
}

/* Help */
.help-copy {
  padding-bottom: 12rpx;
}

.help-copy > text {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-2);
  font-size: var(--font-body);
  line-height: 1.65;
}

.help-warning {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  gap: 12rpx;
  color: var(--color-warning);
  background: var(--color-warning-soft);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.help-warning .icon {
  margin-top: 6rpx;
  font-size: 30rpx;
}

/* First-run onboarding */
.onboarding-layer {
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.onboarding-card {
  position: relative;
  z-index: 21;
  width: 100%;
  padding: 40rpx 40rpx 36rpx;
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--color-surface);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  animation: card-in 0.24s ease-out;
}

@keyframes card-in {
  from { transform: scale(0.96); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.onboarding-dots {
  display: flex;
  gap: 8rpx;
}

.onboarding-dots text {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-fill-strong);
  transition: width 0.2s;
}

.onboarding-dots text.active {
  width: 36rpx;
  background: var(--color-primary);
}

.onboarding-icon {
  margin: 40rpx 0 28rpx;
}

.onboarding-title {
  display: block;
  color: var(--color-text-1);
  font-size: 38rpx;
  font-weight: 600;
}

.onboarding-copy {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-3);
  font-size: var(--font-body);
  line-height: 1.6;
}

.onboarding-actions {
  width: 100%;
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: 20rpx;
}

@media (min-width: 700px) {
  .home-content,
  .route-content,
  .brand-row,
  .plain-header,
  .page-toolbar,
  .profile-hero {
    max-width: 980rpx;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }
  .project-grid,
  .template-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
