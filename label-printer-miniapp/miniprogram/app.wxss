page {
  min-height: 100%;
  background: #f3f4f2;
  color: #202522;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 14px;
  letter-spacing: 0;
}

button,
input,
slider,
switch,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

/* style v2 gives non-mini buttons a 184px width. Reset it at the same
   specificity so flex/grid controls size to their content or their page rule. */
button:not([size="mini"]) {
  width: auto;
  min-width: 0;
}
