@import "styles/icons.wxss";

/* Design tokens. Figma variables use the same names without the leading
   dashes and with "/" after the group: --color-text-1 -> color/text-1. */
page {
  --color-primary: #E02D26;
  --color-primary-pressed: #C4231D;
  --color-primary-soft: #FFF1F0;
  --color-primary-line: #FFCCC7;
  --color-bg: #F5F6F8;
  --color-surface: #FFFFFF;
  --color-fill: #F2F3F5;
  --color-fill-strong: #E8EAED;
  --color-border: #E5E6EB;
  --color-divider: #F0F1F3;
  --color-text-1: #1F2329;
  --color-text-2: #51565D;
  --color-text-3: #646A73;
  /* 5:1 on white, so hints and notes in text-4 stay readable. */
  --color-text-4: #6B7079;
  --color-success: #1E9E62;
  --color-success-soft: #E8F7EF;
  /* Success and warning text: the base colours are too light for words,
     especially on their soft backgrounds. Icons and dots keep the base. */
  --color-success-text: #137A4A;
  --color-warning: #B86E00;
  --color-warning-soft: #FFF6E5;
  --color-warning-text: #8A5200;
  --color-danger: #E02D26;
  --color-danger-soft: #FFF1F0;
  --color-mask: rgba(15, 17, 20, 0.5);
  /* The editor's canvas stage: a shade darker than --color-bg so the
     white label stands out. */
  --color-stage: #EEF0F3;
  --font-display: 40rpx;
  --font-title: 34rpx;
  --font-subtitle: 30rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
  /* Smallest size for words people read: input labels and tags. */
  --font-small: 22rpx;
  /* Corner badges only. */
  --font-tiny: 20rpx;
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 48rpx;
  --gutter: 32rpx;
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 2rpx 8rpx rgba(31, 35, 41, 0.04);
  --shadow-float: 0 12rpx 40rpx rgba(31, 35, 41, 0.12);
  --shadow-primary: 0 8rpx 20rpx rgba(224, 45, 38, 0.28);

  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--font-body);
  line-height: 1.4;
  letter-spacing: 0;
}

button,
input,
textarea,
slider,
switch,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.2;
}

button::after {
  border: 0;
}

/* style v2 gives non-mini buttons a 184px width and auto side margins. Reset
   them at the same specificity so flex/grid controls size to their content or
   their page rule; space buttons with `gap`, not side margins. */
button:not([size="mini"]) {
  width: auto;
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
}

/* The default press state paints buttons grey; keep a light tint instead. */
button.button-hover {
  color: inherit;
  background-color: rgba(31, 35, 41, 0.06);
}

/* Rows and pills are <view>s, so the platform gives them no press state at
   all; these are their hover-class values. */
.pressed-row {
  background-color: var(--color-fill);
}

.pressed-fade {
  opacity: 0.6;
}

button[disabled] {
  opacity: 0.4;
}

/* Buttons */
.primary-button,
.primary-small,
.outline-button,
.danger-button,
.danger-outline {
  min-height: 72rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-body);
  font-weight: 500;
  white-space: nowrap;
}

.primary-button,
.primary-small {
  color: #fff;
  background: var(--color-primary);
}

/* The built-in press and disabled styles are element-qualified, so these are
   too; otherwise a pressed or disabled primary button turns grey. */
button.primary-button.button-hover,
button.primary-small.button-hover {
  color: #fff;
  background: var(--color-primary-pressed);
}

button.primary-button[disabled],
button.primary-small[disabled] {
  color: #fff;
  background: var(--color-primary);
}

.outline-button {
  border: 1rpx solid var(--color-border);
  color: var(--color-text-1);
  background: var(--color-surface);
}

button.outline-button.button-hover {
  background: var(--color-fill);
}

/* Red words on the soft red fill use the pressed red: the brand red only
   reaches about 4.2:1 there. */
.danger-button,
.danger-outline {
  border: 1rpx solid var(--color-primary-line);
  color: var(--color-primary-pressed);
  background: var(--color-danger-soft);
}

.primary-small,
.btn-s {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--font-caption);
}

.btn-l {
  min-height: 88rpx;
  padding: 0 40rpx;
  font-size: var(--font-subtitle);
}

.primary-button .icon,
.primary-small .icon,
.outline-button .icon,
.danger-button .icon,
.danger-outline .icon {
  font-size: 1.15em;
}

button.full-button {
  width: 100%;
}

.text-button {
  min-height: 72rpx;
  padding: 0 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

/* Chips: shape, weight and colour all change when selected. */
.chip {
  flex: none;
  min-height: 60rpx;
  padding: 0 28rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  background: var(--color-fill);
  font-size: var(--font-caption);
  white-space: nowrap;
}

.chip.active {
  border-color: var(--color-primary-line);
  color: var(--color-primary-pressed);
  background: var(--color-primary-soft);
  font-weight: 600;
}

.card {
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.picker-field {
  min-height: 80rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--color-text-1);
  background: var(--color-fill);
  font-size: var(--font-body);
}

.picker-field .icon {
  color: var(--color-text-4);
  font-size: 32rpx;
}

/* Round icon plate for empty states and onboarding. */
.glyph-badge {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: 48rpx;
}

.glyph-badge.large {
  width: 144rpx;
  height: 144rpx;
  font-size: 72rpx;
}

.glyph-badge.neutral {
  color: var(--color-text-3);
  background: var(--color-fill);
}

/* Bottom sheets (shared by home and editor) */
.modal-backdrop {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--color-mask);
  animation: backdrop-in 0.2s ease-out;
}

.bottom-sheet {
  position: fixed;
  z-index: 21;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  padding: 0 var(--gutter) calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  animation: sheet-in 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes sheet-in {
  from { transform: translateY(40%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 16rpx auto 8rpx;
  border-radius: var(--radius-full);
  background: var(--color-fill-strong);
}

.sheet-heading {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-title);
  font-weight: 600;
}

.sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: var(--font-caption);
}

/* The grey circle stays 60rpx; the transparent padding around it makes the
   touch target 88rpx, and the negative margin keeps the circle where it was. */
button.close-button,
button.sheet-close {
  width: 88rpx;
  height: 88rpx;
  margin-right: -14rpx;
  padding: 14rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-2);
  background: var(--color-fill);
  background-clip: content-box;
  font-size: 32rpx;
}

.sheet-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.sheet-actions button {
  flex: 1;
  min-height: 88rpx;
  font-size: var(--font-subtitle);
}

.storage-recovery {
  padding: 160rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  color: var(--color-text-2);
}
