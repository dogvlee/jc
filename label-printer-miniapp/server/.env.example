WECHAT_APP_ID=
WECHAT_APP_SECRET=
HOST=127.0.0.1
PORT=8787
# Default database: server/data/auth.sqlite, independent of the working directory.
# DATABASE_PATH=
SESSION_TTL_DAYS=30
UPSTREAM_TIMEOUT_MS=18000
# Set to 1 only when a reverse proxy sits in front and overwrites X-Real-IP with
# the real client address; it then becomes the rate-limit key per client.
# Without it every user behind the proxy shares one bucket.
TRUST_PROXY=0
# Per-client and global requests per minute (login / session / all account calls).
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_SESSION=120
AUTH_RATE_LIMIT_GLOBAL=300
